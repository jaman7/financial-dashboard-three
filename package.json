    "react-financial-charts": "^2.0.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.1",
    "rxjs": "^7.8.2",
